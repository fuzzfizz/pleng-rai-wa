# ==========================================
# เพลงไรวะ (Pleng-Rai-Wa) - Environment Variables
# ==========================================

# 1. Supabase (Database, Auth, Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Cloudflare R2 (Audio Storage - Zero Egress Fees)
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=pleng-rai-wa-audio
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# 3. AI Providers (Metadata Extraction & Tagging)
# Google AI Studio Gemini API (100% Free Tier: https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key

# 4. Admin Security & App Config
ADMIN_SECRET_KEY=pleng-rai-wa-admin-dev-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 5. Optional: Upstash Redis (Serverless FCFS Buzzer Locking & Distributed Caching)
# Free Tier (10,000 commands/day) on https://upstash.com/ or Vercel Marketplace Integration
# If not configured, the system automatically falls back to Supabase PostgreSQL + In-Memory store
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
